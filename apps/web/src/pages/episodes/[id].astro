---
import Layout from "../../layouts/Layout.astro";
import { getPublishedEpisodes, getEpisodeBySlug, formatDuration, formatFileSize, processDescription, splitDescriptionAtReferenceLinks, getPodcastIndex, getTranscriptSegments, segmentsToText } from "../../lib/api";
import { getEpisodeOgImageUrl } from "../../lib/og";
import { episodeMeta, splitEpisodeTitle } from "../../lib/titles";
import Captions from "../../components/Captions.astro";
import Phrased from "../../components/Phrased.astro";
import Transcript from "../../components/Transcript.astro";
import ClaudeImpression from "../../components/ClaudeImpression.astro";
import type { Episode, TranscriptSegment } from "../../lib/types";

// 前後エピソードのナビゲーション用
interface EpisodeNav {
  id: string;
  title: string;
}

// SSGモード用: ビルド時にパスを生成
export async function getStaticPaths() {
  const [episodes, index] = await Promise.all([
    getPublishedEpisodes(),
    getPodcastIndex(),
  ]);
  const websiteUrl = index.podcast.websiteUrl;
  const podcastArtworkUrl = index.podcast.artworkUrl;
  const spotifyUrl = index.podcast.spotifyUrl || null;
  const defaultIcons = index.podcast.speakerIcons ?? [];

  return Promise.all(
    episodes.map(async (episode, idx) => {
      const transcriptSegments = episode.transcriptUrl
        ? await getTranscriptSegments(episode.transcriptUrl)
        : [];
      const transcriptText = segmentsToText(transcriptSegments);

      // 番組の既定に、その回のぶんを足す。同じ名前があればその回が勝つ。
      // ゲスト回でだけ出る人のアイコンを、エピソード側で足せるようにするため
      const speakerIcons = Object.fromEntries(
        [...defaultIcons, ...(episode.speakerIcons ?? [])].map((icon) => [
          icon.name,
          icon.url,
        ])
      );
      // エピソードは新しい順なので: index小=新しい, index大=古い
      // 前のエピソード = より古い（index + 1）
      // 次のエピソード = より新しい（index - 1）
      const prevEpisode = idx < episodes.length - 1
        ? { id: episodes[idx + 1].id, title: episodes[idx + 1].title }
        : null;
      const nextEpisode = idx > 0
        ? { id: episodes[idx - 1].id, title: episodes[idx - 1].title }
        : null;
      return {
        params: { id: episode.id },
        props: { episode, websiteUrl, transcriptSegments, transcriptText, podcastArtworkUrl, ogImageUrl: getEpisodeOgImageUrl(episode, index.podcast), prevEpisode, nextEpisode, spotifyUrl, speakerIcons },
      };
    })
  );
}

// SSRモード（開発時）はpropsが空なので、paramsから取得
const { id } = Astro.params;
let episode: Episode;
let websiteUrl: string;
let transcriptSegments: TranscriptSegment[] = [];
let transcriptText: string = "";
let podcastArtworkUrl: string;
let ogImageUrl: string;
let prevEpisode: EpisodeNav | null = null;
let nextEpisode: EpisodeNav | null = null;
let spotifyUrl: string | null = null;
let speakerIcons: Record<string, string> = {};

if (Astro.props.episode) {
  // SSGモード: getStaticPathsからpropsが渡される
  episode = Astro.props.episode;
  websiteUrl = Astro.props.websiteUrl;
  transcriptSegments = Astro.props.transcriptSegments || [];
  transcriptText = Astro.props.transcriptText || "";
  podcastArtworkUrl = Astro.props.podcastArtworkUrl || "";
  ogImageUrl = Astro.props.ogImageUrl;
  prevEpisode = Astro.props.prevEpisode || null;
  nextEpisode = Astro.props.nextEpisode || null;
  spotifyUrl = Astro.props.spotifyUrl || null;
  speakerIcons = Astro.props.speakerIcons || {};
} else {
  // SSRモード: paramsから取得してfetch
  const [fetchedEpisode, allEpisodes, index] = await Promise.all([
    getEpisodeBySlug(id!),
    getPublishedEpisodes(),
    getPodcastIndex(),
  ]);
  episode = fetchedEpisode;
  websiteUrl = index.podcast.websiteUrl;
  podcastArtworkUrl = index.podcast.artworkUrl;
  ogImageUrl = getEpisodeOgImageUrl(episode, index.podcast);
  spotifyUrl = index.podcast.spotifyUrl || null;
  speakerIcons = Object.fromEntries(
    [...(index.podcast.speakerIcons ?? []), ...(episode.speakerIcons ?? [])].map(
      (icon) => [icon.name, icon.url]
    )
  );
  transcriptSegments = episode.transcriptUrl
    ? await getTranscriptSegments(episode.transcriptUrl)
    : [];
  transcriptText = segmentsToText(transcriptSegments);
  // 前後のエピソードを探す
  const currentIdx = allEpisodes.findIndex(e => e.id === id);
  if (currentIdx !== -1) {
    if (currentIdx < allEpisodes.length - 1) {
      prevEpisode = { id: allEpisodes[currentIdx + 1].id, title: allEpisodes[currentIdx + 1].title };
    }
    if (currentIdx > 0) {
      nextEpisode = { id: allEpisodes[currentIdx - 1].id, title: allEpisodes[currentIdx - 1].title };
    }
  }
}

const description = processDescription(episode.description, episode, websiteUrl);

// 参考リンクは本文に流し込まず、表にして出す。本文は置き場所の前と後ろに分ける。
// 置き場所が無い説明文では、本文のあとに表を置く
const referenceLinks = episode.referenceLinks ?? [];
const parts = referenceLinks.length > 0 ? splitDescriptionAtReferenceLinks(episode.description) : null;
const descriptionBefore = parts ? processDescription(parts.before, episode, websiteUrl) : description;
const descriptionAfter = parts ? processDescription(parts.after, episode, websiteUrl) : "";

/**
 * 取り込んだページのタイトルには、&amp; のような実体参照がそのまま入っていることがある。
 * そのまま出すと「IoT &amp; Multi-Cloud」と見えるので、字に戻す
 */
function decodeEntities(text: string): string {
  return text
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#0?39;/g, "'")
    .replace(/&amp;/g, "&");
}

function hostOf(url: string): string {
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return "";
  }
}

const title = splitEpisodeTitle(episode.title);
const audioSrc = episode.audioUrl || episode.sourceAudioUrl || "";

---

<Layout title={episode.title} description={description} ogImage={ogImageUrl} ogType="article">
  <article class="mx-auto max-w-[720px] px-5 pb-14 pt-2 sm:px-8 sm:pb-20 sm:pt-6" data-pagefind-body>
    <!-- 見出し -->
    <header class="flex items-start justify-between gap-5">
      <div class="min-w-0">
        <div class="flex items-baseline gap-3">
          {title.number && (
            <span class="tabular text-lg font-bold tracking-tight sm:text-[22px]">{title.number}</span>
          )}
          <time class="tabular text-xs text-text-muted dark:text-text-muted-dark sm:text-[13px]" datetime={episode.publishedAt || episode.publishAt}>
            {episodeMeta(episode)}
          </time>
        </div>
        <h1 class="mt-1.5 break-words text-xl font-bold leading-[1.55] sm:mt-2 sm:text-[32px] sm:leading-[1.5]">
          <Phrased text={title.rest} />
        </h1>
      </div>
      {/* その回だけのアートワークがあるときだけ出す。番組のものは繰り返さない */}
      {episode.artworkUrl && (
        <img
          src={episode.artworkUrl}
          alt=""
          width="112"
          height="112"
          class="h-16 w-16 shrink-0 rounded-xl border-[1.5px] border-ink object-cover dark:border-ink-dark sm:h-28 sm:w-28"
        />
      )}
    </header>

    <!-- プレイヤー -->
    {/* audioUrlがあればそれを使い、なければsourceAudioUrl（RSSインポート時の外部URL）を使用 */}
    <audio id="audio-player" class="hidden" preload="metadata" data-duration={episode.duration}>
      <source src={audioSrc} type="audio/mpeg" />
    </audio>

    <div
      id="player"
      class="mt-5 rounded-xl border-[1.5px] border-ink bg-bg-elevated dark:border-ink-dark dark:bg-bg-elevated-dark sm:mt-7 sm:rounded-[14px]"
    >
      <div class="flex items-center gap-3 py-2 pl-2 pr-3.5 sm:gap-4 sm:py-3 sm:pl-3 sm:pr-5">
        <button
          type="button"
          data-player-toggle
          aria-label="再生"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-[1.5px] border-ink bg-brand-yellow text-ink transition-transform hover:scale-105 sm:h-12 sm:w-12"
        >
          <svg data-icon-play class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          <svg data-icon-pause class="hidden h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z"></path></svg>
        </button>
        <input
          type="range"
          data-player-seek
          min="0"
          max={episode.duration || 0}
          value="0"
          step="1"
          aria-label="再生位置"
          class="player-seek min-w-0 flex-1"
        />
        <span data-player-clock class="tabular shrink-0 text-xs text-text-muted dark:text-text-muted-dark sm:text-[13px]">
          0:00 / {formatDuration(episode.duration)}
        </span>
        <button
          type="button"
          data-player-rate
          aria-label="再生速度"
          class="tabular hidden h-11 shrink-0 items-center px-1 text-[13px] font-medium text-text-muted transition-colors hover:text-accent dark:text-text-muted-dark sm:flex"
        >
          1.0×
        </button>
      </div>

      {transcriptSegments.length > 0 && <Captions icons={speakerIcons} />}
    </div>

    <div class="mt-1.5 flex flex-wrap gap-x-4 whitespace-nowrap text-[13px] font-bold sm:mt-2.5 sm:gap-x-6 sm:text-sm">
      {spotifyUrl && (
        <a href={spotifyUrl} target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center text-accent transition-colors hover:text-accent-hover">
          Spotify で聴く
        </a>
      )}
      {episode.applePodcastsUrl && (
        <a href={episode.applePodcastsUrl} target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center text-accent transition-colors hover:text-accent-hover">
          Apple Podcasts で聴く
        </a>
      )}
      <a href={audioSrc} download class="flex min-h-11 items-center font-medium text-text-muted transition-colors hover:text-accent dark:text-text-muted-dark">
        ダウンロード<span class="hidden sm:inline">（{formatFileSize(episode.fileSize)}）</span>
      </a>
    </div>

    <!-- 概要 -->
    <div
      class="prose mt-3 max-w-none text-[15px] leading-[1.85] text-text dark:text-text-dark sm:mt-5 sm:text-base sm:leading-[1.9]"
      set:html={descriptionBefore}
    />

    {/* 参考リンク。本文に URL を流し込まず、表にする */}
    {referenceLinks.length > 0 && (
      <section class="mt-9 sm:mt-12">
        <h2 class="rule-heading">話に出てきたもの</h2>
        <ul>
          {referenceLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col gap-0.5 border-b border-border py-3 dark:border-border-dark sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
              >
                <span class="break-words text-sm leading-normal transition-colors group-hover:text-accent sm:text-[15px]">{decodeEntities(link.title) || link.url}</span>
                <span class="shrink-0 text-xs text-text-muted dark:text-text-muted-dark sm:text-[13px]">{hostOf(link.url)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {descriptionAfter && (
      <div
        class="prose mt-9 max-w-none text-[15px] leading-[1.85] text-text dark:text-text-dark sm:mt-12 sm:text-base sm:leading-[1.9]"
        set:html={descriptionAfter}
      />
    )}

    {episode.claudeImpression && (
      <ClaudeImpression impression={episode.claudeImpression} />
    )}

    {transcriptSegments.length > 0 && (
      <Transcript segments={transcriptSegments} icons={speakerIcons} />
    )}

    <!-- シェア -->
    <div class="mt-10 flex flex-wrap items-center gap-x-5 border-t border-border text-[13px] dark:border-border-dark sm:mt-12">
      <a
        href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(episode.title)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center text-text-muted transition-colors hover:text-accent dark:text-text-muted-dark"
      >
        X でシェア
      </a>
      <button
        type="button"
        id="copy-url-btn"
        data-url={Astro.url.href}
        class="flex min-h-11 items-center text-text-muted transition-colors hover:text-accent dark:text-text-muted-dark"
      >
        URL をコピー
      </button>
    </div>

    <!-- 前後のエピソード -->
    {(prevEpisode || nextEpisode) && (
      <nav class="grid border-t-[1.5px] border-ink dark:border-ink-dark sm:grid-cols-2 sm:gap-x-14" aria-label="前後のエピソード">
        {prevEpisode ? (
          <a href={`/episodes/${prevEpisode.id}`} class="group flex flex-col gap-1 border-b border-border py-4 dark:border-border-dark sm:border-b-0">
            <span class="text-xs text-text-muted dark:text-text-muted-dark">← 前のエピソード</span>
            <span class="line-clamp-2 text-sm font-bold leading-normal transition-colors group-hover:text-accent">{prevEpisode.title}</span>
          </a>
        ) : (
          <div class="hidden sm:block"></div>
        )}
        {nextEpisode && (
          <a href={`/episodes/${nextEpisode.id}`} class="group flex flex-col gap-1 py-4 sm:items-end sm:text-right">
            <span class="text-xs text-text-muted dark:text-text-muted-dark">次のエピソード →</span>
            <span class="line-clamp-2 text-sm font-bold leading-normal transition-colors group-hover:text-accent">{nextEpisode.title}</span>
          </a>
        )}
      </nav>
    )}

    <!-- 文字起こしテキスト（検索用、非表示） -->
    {transcriptText && (
      <div class="sr-only" data-pagefind-index-attrs="data-transcript" data-transcript={transcriptText}>
        {transcriptText}
      </div>
    )}
  </article>

  {/*
    下に固定する再生バー。上のプレイヤーが画面の外に出ている間だけ出す。
    文字起こしを読み進めても、止める・戻すに手が届くように
  */}
  <div
    id="player-bar"
    class="fixed inset-x-0 bottom-0 z-40 hidden border-t-[1.5px] border-ink bg-bg-elevated dark:border-ink-dark dark:bg-bg-elevated-dark"
  >
    <div class="mx-auto flex max-w-[720px] items-center gap-3 py-2 pl-2.5 pr-4 sm:px-8">
      <button
        type="button"
        data-player-toggle
        aria-label="再生"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-[1.5px] border-ink bg-brand-yellow text-ink"
      >
        <svg data-icon-play class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
        <svg data-icon-pause class="hidden h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z"></path></svg>
      </button>
      <div class="flex min-w-0 flex-1 flex-col gap-1">
        <p id="player-bar-caption" class="truncate text-xs text-text-secondary dark:text-text-secondary-dark">{title.rest}</p>
        <input type="range" data-player-seek min="0" max={episode.duration || 0} value="0" step="1" aria-label="再生位置" class="player-seek" />
      </div>
      <span data-player-clock class="tabular shrink-0 text-xs text-text-muted dark:text-text-muted-dark">0:00</span>
    </div>
  </div>
</Layout>

<style is:global>
  /* 再生位置のつまみ。進んだぶんを青緑で塗る（--played はスクリプトが入れる） */
  .player-seek {
    -webkit-appearance: none;
    appearance: none;
    height: 1.5rem;
    background: transparent;
    cursor: pointer;
    --played: 0%;
  }
  .player-seek::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--color-brand-teal) var(--played),
      var(--color-border) var(--played)
    );
  }
  .player-seek::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: var(--color-border);
  }
  .player-seek::-moz-range-progress {
    height: 4px;
    border-radius: 2px;
    background: var(--color-brand-teal);
  }
  .player-seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--color-ink);
  }
  .player-seek::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--color-ink);
  }
  .dark .player-seek::-webkit-slider-runnable-track {
    background: linear-gradient(
      to right,
      var(--color-brand-teal) var(--played),
      var(--color-border-dark) var(--played)
    );
  }
  .dark .player-seek::-moz-range-track {
    background: var(--color-border-dark);
  }
  /* 知らない擬似要素が混ざると規則ごと捨てられるので、ブラウザごとに分けて書く */
  .dark .player-seek::-webkit-slider-thumb {
    background: var(--color-ink-dark);
  }
  .dark .player-seek::-moz-range-thumb {
    background: var(--color-ink-dark);
  }
</style>

<script>
  import { toCaptions, type Caption } from '../../lib/captions';

  // タイムスタンプ（HH:MM:SS.mmm）を秒数に変換
  function timeToSeconds(time: string): number {
    const parts = time.split(':').map(Number);
    if (parts.length === 3) {
      return parts[0] * 3600 + parts[1] * 60 + parts[2];
    } else if (parts.length === 2) {
      return parts[0] * 60 + parts[1];
    }
    return 0;
  }

  // 0:15:33 / 1:13:45 のように、時間の桁を常に出す。1 時間を超える回があるので、
  // 途中で桁が増えると読みづらい
  function formatClock(seconds: number): string {
    const total = Math.max(0, Math.floor(Number.isFinite(seconds) ? seconds : 0));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  const audio = document.getElementById('audio-player') as HTMLAudioElement | null;
  const transcriptSegments = document.querySelectorAll('.transcript-segment');

  // --- プレイヤー ---
  //
  // 上の本体と、下に固定するバーの 2 か所に同じ操作がある。どちらも同じ audio を動かし、
  // 表示は audio の出来事から両方まとめて書く。
  if (audio) {
    const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-player-toggle]')];
    const seeks = [...document.querySelectorAll<HTMLInputElement>('[data-player-seek]')];
    const clocks = [...document.querySelectorAll<HTMLElement>('[data-player-clock]')];
    const rateButton = document.querySelector<HTMLButtonElement>('[data-player-rate]');
    const player = document.getElementById('player');
    const bar = document.getElementById('player-bar');

    // 長さはメタデータが来るまで取れないので、それまでは meta の値で埋める
    const totalSeconds = () =>
      Number.isFinite(audio.duration) && audio.duration > 0
        ? audio.duration
        : Number(audio.dataset.duration) || 0;

    // つまみを動かしている間は、再生に合わせて位置を書き戻さない
    let seeking = false;

    const paint = () => {
      const total = totalSeconds();
      const now = audio.currentTime;
      const played = total > 0 ? `${Math.min(100, (now / total) * 100)}%` : '0%';

      seeks.forEach((seek) => {
        seek.max = String(Math.floor(total));
        if (!seeking) seek.value = String(Math.floor(now));
        seek.style.setProperty('--played', played);
      });
      clocks.forEach((clock, index) => {
        // 上の本体には全体の長さも出す。下のバーは狭いので現在位置だけ
        clock.textContent =
          index === 0 ? `${formatClock(now)} / ${formatClock(total)}` : formatClock(now);
      });
    };

    const paintToggle = () => {
      const playing = !audio.paused && !audio.ended;
      toggles.forEach((toggle) => {
        toggle.setAttribute('aria-label', playing ? '一時停止' : '再生');
        toggle.querySelector('[data-icon-play]')?.classList.toggle('hidden', playing);
        toggle.querySelector('[data-icon-pause]')?.classList.toggle('hidden', !playing);
      });
    };

    toggles.forEach((toggle) =>
      toggle.addEventListener('click', () => {
        if (audio.paused) void audio.play();
        else audio.pause();
      })
    );

    seeks.forEach((seek) => {
      seek.addEventListener('input', () => {
        seeking = true;
        const total = totalSeconds();
        seek.style.setProperty('--played', total > 0 ? `${(Number(seek.value) / total) * 100}%` : '0%');
      });
      seek.addEventListener('change', () => {
        audio.currentTime = Number(seek.value);
        seeking = false;
        paint();
      });
    });

    const RATES = [1, 1.25, 1.5, 2];
    rateButton?.addEventListener('click', () => {
      const next = RATES[(RATES.indexOf(audio.playbackRate) + 1) % RATES.length];
      audio.playbackRate = next;
      rateButton.textContent = `${next.toFixed(next % 1 === 0 ? 1 : 2).replace(/0$/, '')}×`;
    });

    ['play', 'pause', 'ended'].forEach((name) => audio.addEventListener(name, paintToggle));
    ['timeupdate', 'durationchange', 'loadedmetadata'].forEach((name) =>
      audio.addEventListener(name, paint)
    );
    paint();

    // 下のバーは、一度でも再生していて、上の本体が見えていないときだけ出す。
    // 聞いていない人の画面には何も足さない
    let started = false;
    let playerVisible = true;
    const paintBar = () => bar?.classList.toggle('hidden', !started || playerVisible);

    audio.addEventListener('play', () => {
      started = true;
      paintBar();
    });
    if (player && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        playerVisible = entry.isIntersecting;
        paintBar();
      }).observe(player);
    }
  }

  // URL をコピー
  const copyUrl = document.getElementById('copy-url-btn');
  copyUrl?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(copyUrl.dataset.url ?? location.href);
    copyUrl.textContent = 'コピーしました';
    setTimeout(() => {
      copyUrl.textContent = 'URL をコピー';
    }, 2000);
  });

  // 字幕と、再生中の行のハイライト
  //
  // 行の開始時刻しか無いので、「開始時刻が現在より前で、いちばん後ろ」を今とみなす。
  // 発言をそのまま字幕にすると長すぎるため、割り方は lib/captions.ts に置いてある。
  if (audio && transcriptSegments.length > 0) {
    const segments = [...transcriptSegments];
    const captions = toCaptions(
      segments.map((segment) => ({
        start: timeToSeconds(segment.getAttribute('data-time') ?? ''),
        end: timeToSeconds(segment.getAttribute('data-end') ?? ''),
        text: segment.querySelector('.transcript-text')?.textContent?.trim() ?? '',
        speaker: segment.getAttribute('data-speaker') ?? '',
      }))
    );
    const starts = captions.map((caption) => caption.start);

    // --- 再生中の行に背景を出す ---
    let currentSegment = -1;

    function highlight(index: number): void {
      if (index === currentSegment) return;

      transcriptSegments[currentSegment]?.classList.remove('is-playing');
      transcriptSegments[index]?.classList.add('is-playing');
      currentSegment = index;
    }

    // --- プレイヤー直下の字幕 ---
    const strip = document.getElementById('captions');
    const track = strip?.querySelector<HTMLElement>('.caption-track') ?? null;
    const rows = track ? [...track.querySelectorAll<HTMLElement>('.caption-row')] : [];
    const speakerIcons: Record<string, string> = JSON.parse(strip?.dataset.icons ?? '{}');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // 上へ抜けていく行の薄さ。動かしている最中は読めないので、先に控えておく
    const dimOpacity = rows[1] ? getComputedStyle(rows[1]).opacity : '0.45';

    /** 複数人が同時に喋っている区間は "あずま・鉄塔" のように連結されて届く */
    const SIMULTANEOUS_SEPARATOR = '・';

    /**
     * 話者の印を返す
     *
     * 一度作ったものを枠ごとに取っておいて使い回す。字幕が進むたびに作り直すと、
     * 画像が入れ替わる一瞬だけ抜けて見えることがある。付け外しは動かすだけなので、
     * 読み込みも起きない。
     */
    const speakerNodes = new Map<HTMLElement, Map<string, HTMLElement>>();

    function speakerNode(slot: HTMLElement, name: string): HTMLElement {
      let cache = speakerNodes.get(slot);
      if (!cache) {
        cache = new Map();
        speakerNodes.set(slot, cache);
      }

      const cached = cache.get(name);
      if (cached) return cached;

      const url = speakerIcons[name];
      let node: HTMLElement;

      if (url) {
        const icon = document.createElement('img');
        icon.src = url;
        icon.alt = name;
        icon.title = name;
        icon.width = 24;
        icon.height = 24;
        icon.className = 'h-6 w-6 shrink-0 rounded-full object-cover';
        node = icon;
      } else {
        const label = document.createElement('span');
        label.textContent = name;
        label.className = 'block truncate text-[11px] font-medium leading-tight';
        node = label;
      }

      cache.set(name, node);
      return node;
    }

    /** 1 行ぶんの中身を入れる */
    function fill(row: HTMLElement, caption: Caption | undefined): void {
      const text = row.querySelector<HTMLElement>('.caption-text');
      const slot = row.querySelector<HTMLElement>('.caption-speaker');
      if (!text || !slot) return;

      text.textContent = caption?.text ?? '';

      // 話者が変わったときだけ並べ直す
      const speaker = caption?.speaker ?? '';
      if (slot.dataset.speaker !== speaker) {
        slot.dataset.speaker = speaker;
        slot.replaceChildren(
          ...speaker
            .split(SIMULTANEOUS_SEPARATOR)
            .filter(Boolean)
            .map((name) => speakerNode(slot, name))
        );
      }
    }

    /**
     * 字幕を進める
     *
     * 中身を 1 つずつ上へ詰め替えたあと、詰め替える前の位置から今の位置へ滑らせる。
     * 消してから出すと毎回そこで白くなるので、動かして見せる。
     */
    function render(index: number): void {
      if (!track || rows.length !== 3) return;

      const previous = Number(track.dataset.caption ?? 'NaN');
      if (previous === index) return;
      track.dataset.caption = String(index);

      rows.forEach((row, offset) => fill(row, captions[index - 2 + offset]));

      // 1 枚進んだときだけ滑らせる。シークで飛んだときは差し替えるだけにする
      if (index !== previous + 1 || reducedMotion.matches) return;
      if (typeof track.animate !== 'function') return;

      // 隠れている間は測れない。滑らせようがないので中身の差し替えだけで済ませる
      const step = rows[1].offsetTop - rows[0].offsetTop;
      if (step <= 0) return;

      // 短い字幕が続くと前の動きが終わらないうちに次が来る。積み上げずに捨てる
      track.getAnimations?.().forEach((animation) => animation.cancel());
      rows[1].getAnimations?.().forEach((animation) => animation.cancel());

      // 頭で一気に動いて、あとは滑り込んで止まる。長さより、出だしの速さで切れを出す
      const timing = { duration: 260, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' };

      // CSS では 1 行ぶん上にずらしてある。詰め替える前の位置はその 1 行ぶん下
      track.animate(
        [{ transform: 'translateY(0px)' }, { transform: `translateY(${-step}px)` }],
        timing
      );
      // 上がっていく行は、動きに合わせて薄くする
      rows[1].animate([{ opacity: '1' }, { opacity: dimOpacity }], timing);
    }

    // 再生するまでは出さない。読むだけの人に空の枠を見せない
    audio.addEventListener('play', () => strip?.classList.remove('hidden'), {
      once: true,
    });

    audio.addEventListener('timeupdate', () => {
      const now = audio.currentTime;

      // 二分探索。字幕は千枚を超えるので毎秒なめると重い
      let low = 0;
      let high = starts.length - 1;
      let found = -1;

      while (low <= high) {
        const mid = (low + high) >> 1;
        if (starts[mid] <= now) {
          found = mid;
          low = mid + 1;
        } else {
          high = mid - 1;
        }
      }

      highlight(found < 0 ? -1 : captions[found].utterance);

      // 止めても消さない。読みかけを消さないため
      render(found);

      // 下のバーには、いま喋っている一文を出す
      const barCaption = document.getElementById('player-bar-caption');
      if (barCaption && found >= 0) barCaption.textContent = captions[found].text;
    });

    const clearHighlight = () => highlight(-1);
    audio.addEventListener('pause', clearHighlight);
    audio.addEventListener('ended', clearHighlight);
  }

  // トランスクリプトセグメントのクリックで再生位置を変更
  //
  // 文字起こしはコピーできる必要があるので、テキストを選択しただけのときは
  // 再生位置を動かさない。選択して読み返している最中に音が鳴り出すと邪魔になる。
  if (audio) {
    transcriptSegments.forEach((segment) => {
      segment.addEventListener('click', () => {
        if (!window.getSelection()?.isCollapsed) return;

        const time = segment.getAttribute('data-time');
        if (time) {
          audio.currentTime = timeToSeconds(time);
          audio.play();
        }
      });
    });
  }
</script>
