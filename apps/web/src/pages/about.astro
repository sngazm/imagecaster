---
import Layout from "../layouts/Layout.astro";
import SubscribeLinks from "../components/SubscribeLinks.astro";
import { getPodcastIndex } from "../lib/api";
import { getPodcastOgImageUrl } from "../lib/og";

const index = await getPodcastIndex();
const podcast = index.podcast;

// OGP画像（PodcastアートワークURLを直接使用）
const ogImageUrl = getPodcastOgImageUrl(podcast);
---

<Layout title="番組について" description={podcast.description} ogImage={ogImageUrl}>
  <div class="mx-auto max-w-[720px] px-5 pb-14 pt-4 sm:px-8 sm:pb-20 sm:pt-10">
    <div class="flex items-center gap-4 sm:gap-6">
      {podcast.artworkUrl && (
        <img
          src={podcast.artworkUrl}
          alt=""
          width="112"
          height="112"
          class="h-20 w-20 shrink-0 rounded-xl border-[1.5px] border-ink object-cover dark:border-ink-dark sm:h-28 sm:w-28"
        />
      )}
      <div class="min-w-0">
        <h1 class="text-xl font-bold leading-snug sm:text-[28px]">{podcast.title}</h1>
        {podcast.author && (
          <p class="mt-1 text-[13px] text-text-muted dark:text-text-muted-dark sm:text-sm">{podcast.author}</p>
        )}
      </div>
    </div>

    <p class="mt-6 text-[15px] leading-[1.85] sm:mt-8 sm:text-base sm:leading-[1.9]">{podcast.description}</p>

    <div class="mt-6">
      <SubscribeLinks podcast={podcast} />
    </div>

    <h2 class="rule-heading mt-10 sm:mt-12">番組情報</h2>
    <dl class="grid grid-cols-[6.5rem_minmax(0,1fr)] text-[13px] sm:text-sm">
      {podcast.category && (
        <>
          <dt class="border-b border-border py-3 text-text-muted dark:border-border-dark dark:text-text-muted-dark">カテゴリ</dt>
          <dd class="border-b border-border py-3 dark:border-border-dark">{podcast.category}</dd>
        </>
      )}
      {podcast.language && (
        <>
          <dt class="border-b border-border py-3 text-text-muted dark:border-border-dark dark:text-text-muted-dark">言語</dt>
          <dd class="border-b border-border py-3 dark:border-border-dark">{podcast.language}</dd>
        </>
      )}
      {podcast.email && (
        <>
          <dt class="border-b border-border py-3 text-text-muted dark:border-border-dark dark:text-text-muted-dark">お問い合わせ</dt>
          <dd class="border-b border-border py-3 dark:border-border-dark">
            <a href={`mailto:${podcast.email}`} class="font-bold text-accent hover:text-accent-hover">{podcast.email}</a>
          </dd>
        </>
      )}
      {podcast.websiteUrl && (
        <>
          <dt class="border-b border-border py-3 text-text-muted dark:border-border-dark dark:text-text-muted-dark">ウェブサイト</dt>
          <dd class="break-all border-b border-border py-3 dark:border-border-dark">
            <a href={podcast.websiteUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-accent hover:text-accent-hover">{podcast.websiteUrl}</a>
          </dd>
        </>
      )}
    </dl>
  </div>
</Layout>
