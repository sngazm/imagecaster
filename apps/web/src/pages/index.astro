---
import Layout from "../layouts/Layout.astro";
import Home from "../components/Home.astro";
import { getPublishedEpisodes, getPodcastIndex } from "../lib/api";
import { getPodcastOgImageUrl } from "../lib/og";

const EPISODES_PER_PAGE = 10;
const currentPage = 1;

const allEpisodes = await getPublishedEpisodes();
const index = await getPodcastIndex();
const podcast = index.podcast;

const totalPages = Math.ceil(allEpisodes.length / EPISODES_PER_PAGE);
const episodes = allEpisodes.slice(0, EPISODES_PER_PAGE);

// OGP画像（PodcastアートワークURLを直接使用）
const ogImageUrl = getPodcastOgImageUrl(podcast);
---

<Layout title={podcast.title} description={podcast.description} ogImage={ogImageUrl}>
  <Home podcast={podcast} episodes={episodes} total={allEpisodes.length} currentPage={currentPage} totalPages={totalPages} />
</Layout>
