---
import { resolveSpeakerIcons } from "../lib/speakers";

interface Props {
  /** 話者名 → アイコンのURL。番組の既定にその回のぶんを足したもの */
  icons?: Record<string, string>;
}

const { icons = {} } = Astro.props;

/** 出ていく行・一つ前・いま。見えているのは下 2 行だけ */
const ROLES = ["leaving", "previous", "current"] as const;
---

{/*
  プレイヤー直下の字幕。いま喋っているところと、その一つ前を出す。

  中身は再生に合わせて `episodes/[id].astro` のスクリプトが書く。下の文字起こしの
  DOM から時刻と本文を読むので、ここは器だけ。アイコンの対応表だけ渡しておく。

  行は 3 つある。いちばん上は窓の外に隠れていて、字幕が進むときに中身を 1 つずつ
  上へ詰め替えてから、詰め替える前の位置から滑らせる。上の行が窓の外へ抜け、
  いまの行が一つ前の位置へ上がり、次の行が下から出てくる、という見え方になる。

  文字起こしは下に全文があるので、読み上げには出さない（aria-hidden）。
*/}
<div
  id="captions"
  class="mb-3 hidden border-t border-border pt-3 dark:border-border-dark"
  aria-hidden="true"
  data-icons={JSON.stringify(resolveSpeakerIcons(icons))}
>
  <div class="caption-window">
    <div class="caption-track">
      {
        ROLES.map((role) => (
          <div
            class:list={["caption-row flex gap-2", role !== "current" && "opacity-45"]}
          >
            <span class="caption-speaker flex max-w-14 shrink-0 gap-1 pt-0.5" />
            <p class="caption-text text-sm font-medium leading-relaxed text-text dark:text-text-dark" />
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  #captions {
    /* 行の高さを em で測るので、字幕の文字サイズはここで決める */
    font-size: 0.875rem;
    /* 1 行ぶん = 2 段（line-height 1.625 × 2）。1 枚 28 字は狭い画面でもここに収まる */
    --caption-row: 3.25em;
    --caption-gap: 0.375rem;
  }

  /*
    窓は 2 行ぶん。高さを固定するのは、字幕が入れ替わるたびに下の内容が動くと
    読んでいる側も概要を読んでいる側も落ち着かないため。
  */
  .caption-window {
    overflow: hidden;
    height: calc(2 * var(--caption-row) + var(--caption-gap));
  }

  .caption-track {
    display: flex;
    flex-direction: column;
    gap: var(--caption-gap);
    /* 1 行ぶん上へ。いちばん上の行が窓の外に出る */
    transform: translateY(calc(-1 * (var(--caption-row) + var(--caption-gap))));
  }

  .caption-text {
    min-height: var(--caption-row);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
