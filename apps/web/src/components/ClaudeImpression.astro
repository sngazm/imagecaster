---
interface Props {
  impression: string;
}

const { impression } = Astro.props;

// 空行で段落に分ける
const paragraphs = impression
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<aside
  class="mt-6 rounded-lg border border-border bg-bg-subtle p-4 dark:border-border-dark dark:bg-bg-subtle-dark"
>
  <div class="flex items-center gap-2">
    <span
      class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-[10px] font-bold text-accent"
      aria-hidden="true"
    >
      C
    </span>
    <h2 class="text-xs font-medium text-text-secondary dark:text-text-secondary-dark">
      Claude の感想
    </h2>
  </div>

  <div class="mt-3 space-y-3">
    {
      paragraphs.map((p) => (
        <p class="text-sm leading-relaxed text-text-secondary dark:text-text-secondary-dark">
          {p}
        </p>
      ))
    }
  </div>

  <p class="mt-3 text-[11px] text-text-muted dark:text-text-muted-dark">
    この番組を聴いた Claude (Opus) が書いたものです。本人たちは関与していません。
  </p>
</aside>
