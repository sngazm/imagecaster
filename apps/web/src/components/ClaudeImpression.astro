---
interface Props {
  impression: string;
}

const { impression } = Astro.props;

// 空行で段落に分ける
const paragraphs = impression
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<aside class="mt-9 sm:mt-12">
  <h2 class="rule-heading">Claude の感想</h2>

  <div class="mt-3.5 space-y-3">
    {
      paragraphs.map((p) => (
        <p class="text-[14.5px] leading-[1.85] text-text-secondary dark:text-text-secondary-dark sm:text-[15px]">
          {p}
        </p>
      ))
    }
  </div>

  <p class="mt-3 text-xs text-text-muted dark:text-text-muted-dark">
    この番組を聴いた Claude (Opus) が書いたものです。本人たちは関与していません。
  </p>
</aside>
