---
import { resolveSpeakerIcons, SIMULTANEOUS_SEPARATOR } from "../lib/speakers";
import type { TranscriptSegment } from "../lib/types";

interface Props {
  segments: TranscriptSegment[];
  /** 話者名 → アイコンのURL。番組の既定にその回のぶんを足したもの */
  icons?: Record<string, string>;
}

const { segments, icons = {} } = Astro.props;

/**
 * 話者ごとの色。登場順に割り当てる。
 * Tailwind がクラス名を静的に拾えるよう、文字列として並べておく。
 */
const SPEAKER_CLASSES = [
  "text-speaker-1 dark:text-speaker-1-dark",
  "text-speaker-2 dark:text-speaker-2-dark",
  "text-speaker-3 dark:text-speaker-3-dark",
  "text-speaker-4 dark:text-speaker-4-dark",
];

const SPEAKER_ICONS = resolveSpeakerIcons(icons);

// 色は個々の話者に割り当てる。同時発話のラベルを 1 人分として数えないよう分解しておく
const speakers = [
  ...new Set(
    segments.flatMap((s) =>
      s.speaker ? s.speaker.split(SIMULTANEOUS_SEPARATOR) : []
    )
  ),
];

const hasSpeakers = speakers.length > 0;

function speakerClass(speaker: string): string {
  const index = speakers.indexOf(speaker);
  return SPEAKER_CLASSES[index % SPEAKER_CLASSES.length];
}
---

<details open class="group mt-9 sm:mt-12">
  <summary class="rule-heading flex cursor-pointer list-none items-center justify-between select-none">
    文字起こし
    <svg
      class="h-4 w-4 text-text-muted transition-transform group-open:rotate-90 dark:text-text-muted-dark"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </summary>

  <div
    id="transcript-container"
    class="mt-3 max-h-[28rem] overflow-y-auto overflow-x-hidden pr-1"
  >
    {
      segments.map((segment, index) => {
        // 話者が切り替わったときだけ名前を出す（同じ人が続く間は繰り返さない）
        const isNewSpeaker =
          Boolean(segment.speaker) &&
          segment.speaker !== segments[index - 1]?.speaker;

        return (
          <div
            class:list={[
              "transcript-segment group flex w-full gap-2.5 px-1.5 py-1 text-left rounded-md transition-colors hover:bg-bg-subtle dark:hover:bg-bg-subtle-dark cursor-pointer",
              isNewSpeaker && index > 0 && "mt-3",
            ]}
            data-time={segment.start}
            data-end={segment.end}
            data-speaker={segment.speaker}
          >
            {hasSpeakers && (
              <span class="shrink-0 w-14 pt-0.5 flex gap-1" aria-hidden="true">
                {isNewSpeaker &&
                  segment.speaker
                    ?.split(SIMULTANEOUS_SEPARATOR)
                    .map((name) =>
                      SPEAKER_ICONS[name] ? (
                        <img
                          src={SPEAKER_ICONS[name]}
                          alt={name}
                          title={name}
                          width="24"
                          height="24"
                          loading="lazy"
                          class="h-6 w-6 shrink-0 rounded-full object-cover"
                        />
                      ) : (
                        <span
                          class={`block truncate text-[11px] font-bold leading-tight ${speakerClass(name)}`}
                        >
                          {name}
                        </span>
                      )
                    )}
              </span>
            )}
            <span class="transcript-text cursor-text text-[14.5px] leading-[1.8] text-text dark:text-text-dark sm:text-[15px]">
              {segment.text}
            </span>
          </div>
        );
      })
    }
  </div>
</details>

<style>
  /* 再生中の行。読んでいる邪魔にならない濃さにする */
  .transcript-segment.is-playing {
    background: color-mix(in srgb, var(--color-brand-yellow) 28%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .transcript-segment {
      transition: background-color 0.25s ease;
    }
  }
</style>
