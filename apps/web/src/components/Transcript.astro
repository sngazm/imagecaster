---
import type { TranscriptSegment } from "../lib/types";

interface Props {
  segments: TranscriptSegment[];
}

const { segments } = Astro.props;

/**
 * 話者ごとの色。登場順に割り当てる。
 * Tailwind がクラス名を静的に拾えるよう、文字列として並べておく。
 */
const SPEAKER_CLASSES = [
  "text-speaker-1 dark:text-speaker-1-dark",
  "text-speaker-2 dark:text-speaker-2-dark",
  "text-speaker-3 dark:text-speaker-3-dark",
  "text-speaker-4 dark:text-speaker-4-dark",
];

/** 複数人が同時に喋っている区間は "あずま・鉄塔" のように連結されて届く */
const SIMULTANEOUS_SEPARATOR = "・";

/**
 * 話者のアイコン
 *
 * 名前より速く誰の発言か分かる。用意が無い話者は名前のまま出す。
 */
const SPEAKER_ICONS: Record<string, string> = {
  あずま: "/speakers/azuma.jpg",
  鉄塔: "/speakers/tetto.jpg",
};

// 色は個々の話者に割り当てる。同時発話のラベルを 1 人分として数えないよう分解しておく
const speakers = [
  ...new Set(
    segments.flatMap((s) =>
      s.speaker ? s.speaker.split(SIMULTANEOUS_SEPARATOR) : []
    )
  ),
];

const hasSpeakers = speakers.length > 0;

function speakerClass(speaker: string): string {
  const index = speakers.indexOf(speaker);
  return SPEAKER_CLASSES[index % SPEAKER_CLASSES.length];
}
---

<details open class="mt-4 border-t border-border pt-4 dark:border-border-dark group">
  <summary
    class="cursor-pointer list-none inline-flex items-center gap-1.5 text-xs font-medium text-accent hover:text-accent-hover select-none"
  >
    <svg
      class="h-4 w-4 transition-transform group-open:rotate-90"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 5l7 7-7 7"
      />
    </svg>
    文字起こし
  </summary>

  <button
    id="stop-button"
    type="button"
    class="mt-2 hidden items-center gap-1.5 rounded-full border border-border bg-bg-elevated px-3 py-1 text-xs text-text-secondary transition-colors hover:border-accent hover:text-accent dark:border-border-dark dark:bg-bg-elevated-dark dark:text-text-secondary-dark"
  >
    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="7" y="7" width="10" height="10" rx="1.5" />
    </svg>
    再生を止める
  </button>

  <div
    id="transcript-container"
    class="mt-3 max-h-96 overflow-y-auto overflow-x-hidden pr-2"
  >
    {
      segments.map((segment, index) => {
        // 話者が切り替わったときだけ名前を出す（同じ人が続く間は繰り返さない）
        const isNewSpeaker =
          Boolean(segment.speaker) &&
          segment.speaker !== segments[index - 1]?.speaker;

        return (
          <div
            class:list={[
              "transcript-segment group flex w-full gap-3 px-2 py-1 text-left rounded transition-colors hover:bg-accent/10 dark:hover:bg-accent/20 cursor-pointer",
              isNewSpeaker && index > 0 && "mt-3",
            ]}
            data-time={segment.start}
          >
            {hasSpeakers && (
              <span class="shrink-0 w-14 pt-0.5 flex gap-1" aria-hidden="true">
                {isNewSpeaker &&
                  segment.speaker
                    ?.split(SIMULTANEOUS_SEPARATOR)
                    .map((name) =>
                      SPEAKER_ICONS[name] ? (
                        <img
                          src={SPEAKER_ICONS[name]}
                          alt={name}
                          title={name}
                          width="24"
                          height="24"
                          loading="lazy"
                          class="h-6 w-6 shrink-0 rounded-full object-cover"
                        />
                      ) : (
                        <span
                          class={`block truncate text-[11px] font-medium leading-tight ${speakerClass(name)}`}
                        >
                          {name}
                        </span>
                      )
                    )}
              </span>
            )}
            <span class="transcript-text cursor-text text-sm leading-relaxed text-text-secondary dark:text-text-secondary-dark group-hover:text-text dark:group-hover:text-text-dark transition-colors">
              {segment.text}
            </span>
          </div>
        );
      })
    }
  </div>
</details>

<style>
  /* 再生中の行。読んでいる邪魔にならない濃さにする */
  .transcript-segment.is-playing {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .transcript-segment {
      transition: background-color 0.25s ease;
    }
  }
</style>
